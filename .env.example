# Discord application credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
# Needed to accept Discord SKU purchase webhooks (General Information page)
DISCORD_PUBLIC_KEY=

# Server
PORT=3001
COOKIE_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# Billing webhooks. A webhook that can't be verified is refused.
# Stripe endpoint signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Shared x-webhook-secret header, only for webhooks relayed by your own service
WEBHOOK_SECRET=

# Platform profile only
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard
REDIS_URL=redis://localhost:6379
