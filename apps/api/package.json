{
  "name": "@discord-dashboard/api",
  "version": "3.1.0-alpha.0",
  "description": "HTTP API, OAuth and bot gateway for discord-dashboard.",
  "type": "module",
  "main": "./src/index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Discord-Dashboard/Core.git",
    "directory": "apps/api"
  },
  "homepage": "https://github.com/Discord-Dashboard/Core/tree/v3/apps/api#readme",
  "bugs": {
    "url": "https://github.com/Discord-Dashboard/Core/issues"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no lint yet\"",
    "test": "echo \"no tests yet\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@discord-dashboard/core": "workspace:*",
    "@discord-dashboard/db": "workspace:*",
    "@discord-dashboard/protocol": "workspace:*",
    "@discord-dashboard/schema": "workspace:*",
    "@fastify/cookie": "^11.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "fastify": "^5.10.0",
    "ws": "^8.21.0",
    "@discord-dashboard/billing": "workspace:*",
    "@discord-dashboard/builder": "workspace:*",
    "@discord-dashboard/platform-discord": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.0"
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
