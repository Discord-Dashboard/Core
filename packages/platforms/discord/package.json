{
  "name": "@asctane-dashboard/platform-discord",
  "version": "3.1.0-alpha.0",
  "description": "Discord support for asctane-dashboard: OAuth login, the server list, discord.js pickers and the Discord field widgets.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web.tsx"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Discord-Dashboard/Core.git",
    "directory": "packages/platforms/discord"
  },
  "homepage": "https://github.com/Discord-Dashboard/Core/tree/v3/packages/platforms/discord#readme",
  "bugs": {
    "url": "https://github.com/Discord-Dashboard/Core/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no lint yet\"",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "@asctane-dashboard/core": "workspace:*",
    "@asctane-dashboard/schema": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.7"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./web": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}
