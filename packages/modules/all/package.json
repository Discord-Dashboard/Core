{
  "name": "@acstane/modules",
  "version": "3.1.0-beta.1",
  "description": "Bundle of the reference feature modules.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Discord-Dashboard/Core.git",
    "directory": "packages/modules/all"
  },
  "homepage": "https://github.com/Discord-Dashboard/Core/tree/v3/packages/modules/all#readme",
  "bugs": {
    "url": "https://github.com/Discord-Dashboard/Core/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"no lint yet\""
  },
  "dependencies": {
    "@acstane/schema": "workspace:*",
    "@acstane/module-leveling": "workspace:*",
    "@acstane/module-automod": "workspace:*",
    "@acstane/module-tickets": "workspace:*",
    "@acstane/module-giveaways": "workspace:*",
    "@acstane/module-onboarding": "workspace:*",
    "@acstane/module-reaction-roles": "workspace:*",
    "@acstane/module-autoresponder": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}
