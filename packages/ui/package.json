{
  "name": "@acstane/dashboard-ui",
  "version": "3.1.0-beta.2",
  "description": "Component library, design tokens and themes for @acstane/dashboard.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Discord-Dashboard/Core.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Discord-Dashboard/Core/tree/v3/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/Discord-Dashboard/Core/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/tokens.css', 'dist/tokens.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no lint yet\"",
    "test": "echo \"no tests yet\""
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./tokens.css": "./dist/tokens.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
