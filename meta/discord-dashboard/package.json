{
  "name": "discord-dashboard",
  "version": "3.0.0-alpha.0",
  "description": "Batteries included dashboard for discord.js bots.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no lint yet\"",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "@discord-dashboard/api": "workspace:*",
    "@discord-dashboard/core": "workspace:*",
    "@discord-dashboard/schema": "workspace:*"
  },
  "peerDependencies": {
    "discord.js": "^14.26.4"
  },
  "peerDependenciesMeta": {
    "discord.js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}
