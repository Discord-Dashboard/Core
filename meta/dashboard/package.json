{
  "name": "@acstane/dashboard",
  "version": "3.1.0-beta.2",
  "description": "Batteries included dashboard for discord.js bots.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Discord-Dashboard/Core.git",
    "directory": "meta/dashboard"
  },
  "homepage": "https://github.com/Discord-Dashboard/Core/tree/v3/meta/dashboard#readme",
  "bugs": {
    "url": "https://github.com/Discord-Dashboard/Core/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no lint yet\"",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "@acstane/core": "workspace:*",
    "@acstane/db": "workspace:*",
    "@acstane/platform-discord": "workspace:*",
    "@acstane/schema": "workspace:*",
    "@acstane/web": "workspace:*",
