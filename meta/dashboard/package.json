  },
  "peerDependencies": {
    "discord.js": "^14.26.4"
  },
  "peerDependenciesMeta": {
    "discord.js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
